rules_version = '2';
// Shared PIBASE + Warrior Challenge policy. Bootstrap PIBASE access documents FIRST.
// Canonical file: security/muse/firestore.rules. Root mirror must stay identical.
// Kiosk auth reads ONLY the sanitized kioskApplicants collection, never
// full applicant documents. See docs/privacy-hardening.md for the design.
// Never put passwords, tokens, or service-account keys in this repository.
service cloud.firestore {
  match /databases/{database}/documents {
    function access() {
      return get(/databases/$(database)/documents/access/$(request.auth.uid)).data;
    }
    function enabled() {
      return request.auth != null
        && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && access().get('enabled', false) == true;
    }
    function owner() {
      return enabled() && access().get('role', '') == 'owner'
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function assistant() {
      return enabled() && access().get('role', '') == 'assistant'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function reader() {
      return owner() || (assistant() && access().get('read', false) == true)
        || (reviewer() && access().get('read', false) == true);
    }
    // Kiosk display role: reads ONLY the sanitized kioskApplicants
    // collection plus events, results, mission, and the daily reminder.
    // It cannot read full applicant documents, notes, or survey data.
    // No provider constraint: the Pi signs in anonymously, the legacy
    // iPad with a display account's email/password.
    function kiosk() {
      return enabled() && access().get('role', '') == 'kiosk';
    }
    function writer() {
      return owner() || (assistant() && access().get('read', false) == true
        && access().get('write', false) == true);
    }
    // Survey-lead reviewer: read-only on PIBASE data, scoped review rights on
    // surveyLeadImports, and may create ONLY the deterministic separate-
    // applicant record for a reviewed submission (fully attributed).
    function reviewer() {
      return enabled() && access().get('role', '') == 'reviewer'
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // Least-privilege integration role for the SURVEY sync worker. Narrower
    // than assistant: read-only on applicants (for duplicate detection), may
    // create ONLY deterministic survey-{uuid} applicant records, full access
    // to the sync bookkeeping collections, and nothing else. Cannot update or
    // delete applicants, write notes, or touch any other collection.
    function syncer() {
      return enabled() && access().get('role', '') == 'sync'
        && request.auth.token.firebase.sign_in_provider == 'password'
        && access().get('read', false) == true
        && access().get('write', false) == true;
    }
    function attributed() {
      return request.resource.data.get('updatedBy', '') == request.auth.uid
        && request.resource.data.get('updatedAt', null) == request.time;
    }
    function nonempty(value) {
      return value is string && value.size() > 0;
    }
    function validApplicant() {
      let d = request.resource.data;
      return nonempty(d.get('name', ''))
        && (d.get('age', null) == null || d.age is int)
        && (d.get('dependents', null) == null || d.dependents is int)
        && (d.get('phone', null) == null || d.phone is string)
        && (d.get('email', null) == null || d.email is string)
        && (d.get('statusStage', null) == null || d.statusStage is string)
        && (d.get('medicalIssueFlag', null) == null
          || d.medicalIssueFlag in ['yes', 'no', 'unknown'])
        && (d.get('legalIssueFlag', null) == null
          || d.legalIssueFlag in ['yes', 'no', 'unknown']);
    }
    // Legacy free-text medical/legal fields are frozen: no new record may
    // carry them, and no update may introduce or change them. Removal goes
    // through the approved console retention process, not casual edits.
    function noNewLegacyFields() {
      return request.resource.data.get('physicalHealth', null) == null
        && request.resource.data.get('legalIssues', null) == null;
    }
    function legacyFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['physicalHealth', 'legalIssues']);
    }
    // Sanitized kiosk copy: the key whitelist is the enforcement — even
    // the owner cannot put phone, email, flags, waiver data, or notes
    // into a mirror. Keep in sync with KIOSK_APPLICANT_FIELDS in
    // pibase-util.js.
    function validKioskApplicant() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'statusStage', 'age', 'generalArea',
          'priorService', 'educationLevel', 'nextAction', 'nextActionDate',
          'precedence', 'updatedAt', 'createdAt', 'archived', 'archiveFolder',
          'updatedBy'])
        && nonempty(d.get('name', ''))
        && d.get('updatedAt', null) is timestamp
        && (d.get('createdAt', null) == null || d.createdAt is timestamp)
        && (d.get('age', null) == null || d.age is int)
        && (d.get('archived', null) == null || d.archived is bool)
        && (d.get('statusStage', null) == null || d.statusStage is string)
        && (d.get('generalArea', null) == null || d.generalArea is string)
        && (d.get('priorService', null) == null || d.priorService is string)
        && (d.get('educationLevel', null) == null
          || d.educationLevel is string)
        && (d.get('nextAction', null) == null || d.nextAction is string)
        && (d.get('nextActionDate', null) == null
          || d.nextActionDate is string)
        && (d.get('precedence', null) == null || d.precedence is string)
        && (d.get('archiveFolder', null) == null || d.archiveFolder is string)
        && (d.get('updatedBy', null) == null || d.updatedBy is string);
    }
    // Mirror attribution is by updatedBy alone: updatedAt is copied
    // applicant data (a backfill must preserve it, or every Review badge
    // would clear), not the mirror's own write time.
    function mirrorAttributed() {
      return request.resource.data.get('updatedBy', '') == request.auth.uid;
    }
    function active(d) {
      return d.get('archived', false) != true
        && d.get('archiveFolder', null) in [null, ''];
    }
    // Only console/Admin provisioning may change roles or the revocation switch.
    match /access/{uid} {
      allow read, write: if false;
    }
    match /applicants/{id} {
      allow read: if reader() || syncer();
      allow create: if writer() && validApplicant() && noNewLegacyFields()
        && (owner() || (attributed() && active(request.resource.data)));
      // Reviewers may create ONLY the deterministic separate-applicant record
      // for a reviewed survey submission: source-stamped, New Lead stage,
      // fully attributed. No other applicant writes.
      allow create: if reviewer() && validApplicant() && attributed()
        && noNewLegacyFields()
        && active(request.resource.data)
        && id.matches('^survey-[0-9a-fA-F-]{36}-separate$')
        && request.resource.data.get('source', '') == 'SURVEY'
        && request.resource.data.get('surveyResponseId', '') is string
        && request.resource.data.get('statusStage', '') == 'New Lead';
      // Integration worker may create ONLY deterministic survey-{uuid}
      // applicant records: source-stamped, New Lead stage, fully attributed.
      // No updates, no deletes, no other IDs, no other collections.
      allow create: if syncer() && validApplicant() && attributed()
        && noNewLegacyFields()
        && active(request.resource.data)
        && id.matches('^survey-[0-9a-fA-F-]{36}$')
        && request.resource.data.get('source', '') == 'SURVEY'
        && request.resource.data.get('statusStage', '') == 'New Lead';
      allow update: if writer() && validApplicant() && legacyFieldsUnchanged()
        && (owner() || (attributed() && active(resource.data)
          && active(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['archived', 'archiveFolder', 'archivedAt', 'archivedFiscalYear'])));
      allow delete: if false;
      match /notes/{noteId} {
        allow read: if reader();
        allow create: if writer() && nonempty(request.resource.data.get('text', ''))
          && (owner() || (attributed()
            && request.resource.data.get('createdAt', null) == request.time
            && active(get(/databases/$(database)/documents/applicants/$(id)).data)));
        // Assistant notes are append-only; existing history cannot be rewritten.
        allow update: if owner() && nonempty(request.resource.data.get('text', ''));
        allow delete: if false;
      }
    }
    // Sanitized kiosk data: the only applicant collection kiosk auth may
    // read. Mirrors are written by the editor on every applicant save and
    // by "Rebuild kiosk data"; the key whitelist in validKioskApplicant()
    // is the enforcement. Mirrors are never deleted client-side (an
    // archived applicant's mirror stays, marked archived, so the kiosk
    // mission count stays correct).
    match /kioskApplicants/{id} {
      allow read: if kiosk() || reader();
      allow create, update: if (owner() || (writer() && mirrorAttributed()))
        && validKioskApplicant();
      // The SURVEY sync worker may mirror the leads it creates (same
      // deterministic IDs). Create-only, like its applicant writes:
      // the worker never updates records. Optional until the worker is
      // updated; until then the editor's drift check flags its leads as
      // missing and a rebuild mirrors them (see docs/privacy-hardening.md).
      allow create: if syncer() && mirrorAttributed()
        && validKioskApplicant()
        && id.matches('^survey-[0-9a-fA-F-]{36}$');
      allow create: if reviewer() && mirrorAttributed()
        && validKioskApplicant()
        && id.matches('^survey-[0-9a-fA-F-]{36}-separate$');
      allow delete: if false;
    }
    match /events/{id} {
      allow read: if reader() || kiosk();
      // Event notes live in the reader-only subcollection below, never in
      // the kiosk-readable parent doc: a create must not carry them, and
      // an update must not touch them (legacy in-doc values, if any, stay
      // untouched until the console cleanup — see docs/privacy-hardening.md).
      allow create: if writer()
        && nonempty(request.resource.data.get('name', ''))
        && (request.resource.data.get('date', null) == null || request.resource.data.date is string)
        && !('notes' in request.resource.data)
        && !('resultNotes' in request.resource.data)
        && (owner() || attributed());
      allow update: if writer()
        && nonempty(request.resource.data.get('name', ''))
        && (request.resource.data.get('date', null) == null || request.resource.data.date is string)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['notes', 'resultNotes'])
        && (owner() || attributed());
      allow delete: if false;
      // Planning and result notes are reader-only: the kiosk role has no
      // allow here, so it cannot read this subcollection at all. One doc
      // per note kind ('planning' / 'results'), {text, updatedAt,
      // updatedBy}; free-text only, no structured fields.
      match /notes/{noteId} {
        allow read: if reader();
        allow create, update: if writer() && (owner() || attributed())
          && request.resource.data.keys().hasOnly(['text', 'updatedAt', 'updatedBy'])
          && request.resource.data.get('text', null) is string;
        allow delete: if false;
      }
    }
    match /eventResults/{id} {
      allow read: if reader() || kiosk();
      // Result notes live in the reader-only subcollection below, never
      // in the kiosk-readable parent doc (same freeze pattern as events).
      allow create: if writer()
        && nonempty(request.resource.data.get('summary', ''))
        && request.resource.data.get('start', null) is string
        && !('resultNotes' in request.resource.data)
        && (owner() || attributed());
      allow update: if writer()
        && nonempty(request.resource.data.get('summary', ''))
        && request.resource.data.get('start', null) is string
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['resultNotes'])
        && (owner() || attributed());
      allow delete: if false;
      // One doc ('results'), {text, updatedAt, updatedBy}; reader-only.
      match /notes/{noteId} {
        allow read: if reader();
        allow create, update: if writer() && (owner() || attributed())
          && request.resource.data.keys().hasOnly(['text', 'updatedAt', 'updatedBy'])
          && request.resource.data.get('text', null) is string;
        allow delete: if false;
      }
    }
    match /settings/mission {
      allow read: if reader() || kiosk();
      allow create, update: if owner();
      allow delete: if false;
    }
    // Daily reminder state is readable by enrolled devices; only the phone
    // owner may acknowledge it. Assistants cannot dismiss the owner's warning.
    match /settings/{settingId} {
      allow read: if settingId.matches('inputAppointments-[0-9]{4}-[0-9]{2}-[0-9]{2}') && (reader() || kiosk());
      allow create, update: if settingId.matches('inputAppointments-[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && owner()
        && request.resource.data.keys().hasOnly(['dismissed'])
        && request.resource.data.dismissed == true;
      allow delete: if false;
    }
    // Unknown collections and settings documents have no allow rule.

    // ---- SURVEY lead integration (additive; existing rules above untouched) ----
    // surveyLeadImports/{responseId}: idempotency record + review state + audit.
    // surveyLeadDedupes/{key}: atomic cross-submission contact-claim locks.
    //   Keys are "e:"/"p:" + sha256 hex; raw contact info never in document IDs.
    // recruiterMappings/{slug}: explicit SURVEY recruiter slug -> Firebase UID.
    //   Console-provisioned only; clients can never write it.
    function mappedRecruiterDoc(slug) {
      return exists(/databases/$(database)/documents/recruiterMappings/$(slug))
        ? get(/databases/$(database)/documents/recruiterMappings/$(slug)).data
        : null;
    }
    function importReviewer(slug) {
      return owner() || (enabled()
        && mappedRecruiterDoc(slug) != null
        && mappedRecruiterDoc(slug).get('active', false) == true
        && mappedRecruiterDoc(slug).get('uid', '') == request.auth.uid);
    }
    function validImportTransition(from, to) {
      return from == 'review' && to in ['linked', 'dismissed', 'imported'];
    }
    // Audit integrity: decisions grow by exactly one appended entry; the
    // author's identity is server-enforced (by == auth.uid) and the decision
    // time is the document-level updatedAt == request.time (already enforced
    // for every update). No per-entry timestamp: the Firestore client SDK
    // does not allow serverTimestamp() inside arrays, and transitions are
    // terminal (review -> linked/dismissed/imported), so at most one decision
    // ever exists and updatedAt is unambiguously its time.
    function validDecisionAppend(oldDecisions, newDecisions) {
      return newDecisions is list && oldDecisions is list
        && newDecisions.size() == oldDecisions.size() + 1
        && newDecisions.hasAll(oldDecisions)
        && newDecisions[newDecisions.size() - 1].keys()
          .hasOnly(['by', 'action', 'note'])
        && newDecisions[newDecisions.size() - 1].get('by', '') == request.auth.uid
        && newDecisions[newDecisions.size() - 1].get('action', '')
          in ['linked', 'dismissed', 'created-separate'];
    }
    match /recruiterMappings/{slug} {
      // Owner sees all; a mapped recruiter can discover only their own record
      // via a uid-filtered list query (used by the review UI for scoping).
      allow get: if owner()
        || (enabled() && request.auth.uid == resource.data.get('uid', ''));
      allow list: if owner()
        || (enabled() && resource.data.get('uid', '') == request.auth.uid);
      // Console-provisioned only. No client may create, change, or delete.
      allow create, update, delete: if false;
    }
    match /surveyLeadDedupes/{key} {
      allow read: if reader() || syncer();
      allow create: if (writer() || syncer())
        && key.matches('^[ep]:[0-9a-f]{64}$')
        && request.resource.data.keys()
          .hasOnly(['responseId', 'applicantId', 'createdBy', 'createdAt'])
        && request.resource.data.get('responseId', '') is string
        && request.resource.data.get('responseId', '').size() == 36
        && (request.resource.data.get('applicantId', null) == null
          || request.resource.data.get('applicantId', null) is string)
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.get('createdAt', null) == request.time;
      allow update: if (writer() || syncer())
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['applicantId', 'updatedBy', 'updatedAt'])
        && request.resource.data.get('applicantId', null) is string
        && request.resource.data.get('updatedBy', '') == request.auth.uid
        && request.resource.data.get('updatedAt', null) == request.time;
      allow delete: if false;
    }
    match /surveyLeadImports/{responseId} {
      // Writers (owner, integration worker) and mapped reviewers may read;
      // reviewers are isolated to their own recruiter slug.
      allow read: if writer() || syncer() || importReviewer(resource.data.get('recruiterSlug', ''));
      allow create: if (writer() || syncer())
        // Deterministic ID: the document ID must equal the responseId field.
        && responseId == request.resource.data.get('responseId', '')
        && request.resource.data.keys().hasOnly(['responseId', 'recruiterSlug',
          'status', 'applicantId', 'normalizedEmail', 'normalizedPhone',
          'surveySnapshot', 'duplicateCandidates', 'decisions', 'lastError',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && request.resource.data.get('recruiterSlug', '')
          .matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.get('status', '') in ['imported', 'review', 'failed']
        && (request.resource.data.get('applicantId', null) == null
          || request.resource.data.get('applicantId', null) is string)
        && (request.resource.data.get('lastError', null) == null
          || request.resource.data.get('lastError', null) is string)
        && request.resource.data.get('normalizedEmail', null) is string
        && request.resource.data.get('normalizedPhone', null) is string
        && request.resource.data.get('surveySnapshot', null) is map
        && request.resource.data.get('duplicateCandidates', null) is list
        && request.resource.data.get('decisions', null) == []
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('updatedBy', '') == request.auth.uid
        && request.resource.data.get('updatedAt', null) == request.time;
      // Review actions (owner or mapped reviewer) with a server-enforced audit
      // entry, OR worker retry recovery from a recorded failure.
      allow update: if (
          ((owner() || (reviewer() && importReviewer(resource.data.get('recruiterSlug', ''))))
            && validImportTransition(
              resource.data.get('status', ''), request.resource.data.get('status', ''))
            && validDecisionAppend(
              resource.data.get('decisions', []), request.resource.data.get('decisions', []))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status', 'applicantId', 'duplicateCandidates', 'decisions',
               'updatedBy', 'updatedAt']))
          ||
          ((writer() || syncer()) && resource.data.get('status', '') == 'failed'
            && request.resource.data.get('status', '') in ['imported', 'review']
            && request.resource.data.get('decisions', []) == resource.data.get('decisions', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status', 'applicantId', 'normalizedEmail', 'normalizedPhone',
               'surveySnapshot', 'duplicateCandidates', 'lastError',
               'updatedBy', 'updatedAt']))
        )
        && request.resource.data.get('updatedBy', '') == request.auth.uid
        && request.resource.data.get('updatedAt', null) == request.time
        // Immutable once created.
        && request.resource.data.get('responseId', '')
          == resource.data.get('responseId', '')
        && request.resource.data.get('recruiterSlug', '')
          == resource.data.get('recruiterSlug', '')
        && request.resource.data.get('createdAt', null)
          == resource.data.get('createdAt', null)
        && request.resource.data.get('createdBy', '')
          == resource.data.get('createdBy', '');
      allow delete: if false;
    }

    // Warrior Challenge: independent membership, no access/ role inheritance.
    function wcMember(c) { return get(/databases/$(database)/documents/warriorChallenges/$(c)/members/$(request.auth.uid)).data; }
    function wcActive(c) { return request.auth != null && exists(/databases/$(database)/documents/warriorChallenges/$(c)/members/$(request.auth.uid)) && wcMember(c).active == true; }
    function wcAdmin(c) { return wcActive(c) && wcMember(c).role == 'admin'; }
    function wcStation(c, e) { return wcActive(c) && (wcMember(c).role == 'admin' || e in wcMember(c).eventIds); }
    function wcSafeId(s) { return s is string && s.matches('^[A-Za-z0-9_-]{1,80}$'); }
    function wcParent(c, p) { return get(/databases/$(database)/documents/warriorChallenges/$(c)/journal/$(p)).data; }
    function wcSameParent(c, d, p) {
      let prior = wcParent(c,p);
      return wcSafeId(p) && p != d.opId && prior.competitionId == c
        && prior.eventId == d.eventId && prior.teamId == d.teamId
        && prior.schemaVersion == 1 && prior.rulesVersion == d.rulesVersion
        && prior.kind in ['result.submit','result.correct','result.void','result.resolve'];
    }
    function wcParents(c,d) {
      return d.parentIds is list && d.parentIds.size() <= 4
        && d.parentIds.toSet().size() == d.parentIds.size()
        && (d.parentIds.size() < 1 || wcSameParent(c,d,d.parentIds[0]))
        && (d.parentIds.size() < 2 || wcSameParent(c,d,d.parentIds[1]))
        && (d.parentIds.size() < 3 || wcSameParent(c,d,d.parentIds[2]))
        && (d.parentIds.size() < 4 || wcSameParent(c,d,d.parentIds[3]));
    }
    function wcValidKind(c,d) {
      let official = wcAdmin(c);
      return (d.kind == 'result.submit' && d.parentIds.size() == 0)
        || (d.kind == 'result.void' && d.parentIds.size() == 1
            && (official || (wcParent(c,d.parentIds[0]).actorUid == request.auth.uid && wcParent(c,d.parentIds[0]).kind != 'result.void')))
        || (d.kind == 'result.correct' && d.parentIds.size() == 1
            && (official || (wcParent(c,d.parentIds[0]).kind == 'result.void' && wcParent(c,d.parentIds[0]).actorUid == request.auth.uid)))
        || (d.kind == 'result.resolve' && d.parentIds.size() >= 2 && official);
    }
    function wcPayload(d,e) {
      return d.payload is map && d.payload.reason is string && d.payload.reason.size() <= 500
        && (d.kind == 'result.submit' || d.payload.reason.size() >= 1)
        && ((d.kind == 'result.void' && d.payload.keys().hasOnly(['reason']) && d.payload.keys().hasAll(['reason']))
          || (d.kind != 'result.void' && d.payload.keys().hasOnly(['value','reason']) && d.payload.keys().hasAll(['value','reason'])
            && d.payload.value is int && d.payload.value >= e.minimum && d.payload.value <= e.maximum));
    }
    function wcValid(c,op,d) {
      let config = get(/databases/$(database)/documents/warriorChallenges/$(c)).data;
      let event = get(/databases/$(database)/documents/warriorChallenges/$(c)/events/$(d.eventId)).data;
      let team = get(/databases/$(database)/documents/warriorChallenges/$(c)/teams/$(d.teamId)).data;
      return d.keys().hasOnly(['opId','competitionId','eventId','teamId','schemaVersion','rulesVersion','actorUid','deviceId','sessionId','capturedAtClientMs','kind','parentIds','payload','receivedAt'])
        && d.keys().hasAll(['opId','competitionId','eventId','teamId','schemaVersion','rulesVersion','actorUid','deviceId','sessionId','capturedAtClientMs','kind','parentIds','payload','receivedAt'])
        && wcSafeId(op) && d.opId == op && d.competitionId == c
        && wcSafeId(d.eventId) && wcSafeId(d.teamId) && wcSafeId(d.deviceId) && wcSafeId(d.sessionId)
        && d.actorUid == request.auth.uid && d.schemaVersion == 1 && d.rulesVersion == 'practice-v1'
        && config.mode == 'practice' && config.rulesVersion == d.rulesVersion
        && team.eligible == true && team.rosterVersion == config.rosterVersion
        && event.kind == 'numeric' && event.minimum == 0 && event.maximum == 100
        && event.state in ['open','closing'] && wcStation(c,d.eventId)
        && d.capturedAtClientMs is int && d.capturedAtClientMs >= 0 && d.capturedAtClientMs <= 9007199254740991
        && d.receivedAt == request.time && wcParents(c,d) && wcValidKind(c,d) && wcPayload(d,event);
    }
    match /warriorChallenges/{c} {
      allow read: if wcActive(c);
      match /members/{uid} { allow read: if wcActive(c) && (uid == request.auth.uid || wcAdmin(c)); }
      match /teams/{id} { allow read: if wcActive(c); }
      match /events/{id} { allow read: if wcStation(c,id); }
      match /journal/{op} {
        // Missing-ID reads permit idempotency checks, not enumeration of private data.
        allow get: if wcActive(c) && (!exists(/databases/$(database)/documents/warriorChallenges/$(c)/journal/$(op)) || wcStation(c,resource.data.eventId));
        allow list: if wcStation(c,resource.data.eventId);
        allow create: if wcActive(c) && wcValid(c,op,request.resource.data);
        allow update, delete: if false;
      }
      // Publication is deliberately closed until M4's atomic protocol is implemented.
    }
    match /{path=**} { allow read, write: if false; }
  }
}
